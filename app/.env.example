# AI Beer Sommelier Environment Configuration
# Copy this to .env and fill in your values

# ===========================================
# FIREBASE CONFIGURATION
# ===========================================

# Get these from Firebase Console > Project Settings > Your Apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ===========================================
# AI CONFIGURATION (Optional)
# ===========================================

# OpenAI API Key for AI sommelier features
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===========================================
# GOOGLE CONFIGURATION
# ===========================================

# Google Sign-In Web Client ID (from Google Cloud Console)
GOOGLE_WEB_CLIENT_ID=

# Google Places API Key (for location features)
GOOGLE_PLACES_API_KEY=

# ===========================================
# REVENUECAT CONFIGURATION
# ===========================================

# RevenueCat API Keys for subscription management
# Get these from RevenueCat Dashboard > Project > API Keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
